# Public donation configuration — copy to .env.local and fill in real values
# before deploying for real donations. These are NOT secrets: a UPI ID and a
# phone number are meant to be publicly visible to donors. If left unset, the
# app falls back to obvious placeholder values (see
# src/components/donation/config.ts) rather than failing to build.

VITE_UPI_ID=sacrificeonepizza@upi
VITE_PHONE_NUMBER=+91 00000 00000

# --- Backend (server-only — never exposed to the browser, no VITE_ prefix) ---

# Neon Postgres connection string (pooled endpoint recommended — hostname
# contains "-pooler"). Get this from the Neon dashboard for your project.
# Required by db/client.ts and drizzle.config.ts.
DATABASE_URL=

# Vercel Blob read-write token for the project's Blob store (Vercel dashboard
# → Storage → your Blob store → .env.local tab). Required by
# api/uploads/screenshot.ts and any admin-side blob deletion.
BLOB_READ_WRITE_TOKEN=

# Set to "production" only in the real Vercel deployment — controls whether
# the admin session cookie gets the `Secure` flag (browsers reject `Secure`
# cookies over plain http://, which local dev uses).
NODE_ENV=

# One-time admin account creation/rotation — NOT read by the running app,
# only by `npm run db:seed-admin` (see db/seedAdmin.ts). Never commit real
# values; set them inline on the command line when you actually run it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
